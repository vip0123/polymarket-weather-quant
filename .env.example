# Polymarket CLOB API credentials — generate via py_clob_client.auth for each wallet
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Wallet
POLY_PRIVATE_KEY=0x...
POLY_WALLET_ADDRESS=0x...
POLY_FUNDER=0x...               # usually same as wallet address
POLY_SIGNATURE_TYPE=1           # 1 for magic-link proxy wallets, 0 for EOA

# Copy engine (optional)
COPY_TARGET_WALLET=0x1f66796b45581868376365aef54b51eb84184c8d  # maskache2 (weather specialist)

# Alchemy Polygon WS endpoint (for copy engine trade stream)
POLYGON_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Relayer API key (optional)
RELAYER_API_KEY=
